# Never commit real credentials. Use .env.local or your deployment secret store.
OPENAI_API_KEY=
API_KEY=change-me
# COGNIGY_SPEECH_TOKEN takes precedence over API_KEY when both are set.
COGNIGY_SPEECH_TOKEN=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_DELAY=low
OPENAI_STT_SILENCE_MS=700
OPENAI_STT_MIN_SPEECH_MS=100
OPENAI_STT_VAD_RMS=400
OPENAI_STT_TIMEOUT_MS=10000
OPENAI_TTS_MODEL=gpt-realtime-2.1-mini
OPENAI_TTS_TRANSPORT=realtime
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_VOICE=marin
# Comma-separated allowlist. Defaults to the current Realtime built-in voices.
OPENAI_TTS_ALLOWED_VOICES=alloy,ash,ballad,coral,echo,sage,shimmer,verse,marin,cedar
OPENAI_TTS_TIMEOUT_MS=60000
HTTP_PORT=3000
ADAPTER_BIND_ADDRESS=0.0.0.0
ADAPTER_PORT=8086
HTTP_BODY_LIMIT=128kb
LOGLEVEL=info
TTS_STREAMING_ENABLED=false
